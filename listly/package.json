{
  "name": "listly",
  "version": "0.1.0",
  "private": true,
  "main": "./index.ts",
  "workspaces": [
    "packages/go-mobile-design-system"
  ],
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @go-commerce/mobile-design-system",
    "validate": "npm run validate --workspace @go-commerce/mobile-design-system",
    "bundle:ios": "expo export --platform ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@go-commerce/mobile-design-system": "0.1.0",
    "expo": "~58.0.24",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "~0.21.4",
    "tamagui": "3.3.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "~5.9.3"
  }
}
